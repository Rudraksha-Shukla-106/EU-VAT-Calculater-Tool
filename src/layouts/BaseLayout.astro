---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  robots?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  canonicalPath = '/',
  robots = 'index, follow',
  schema,
  ogImage = '/og-image.svg',
  ogImageAlt = 'VatSnap — free EU VAT calculator',
} = Astro.props as Props;

const SITE = 'https://vatratefinder.com';
const canonical = new URL(canonicalPath, SITE).toString();
const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C0V9Y4KFDR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-C0V9Y4KFDR');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Theme: explicit localStorage choice wins, otherwise system preference.
      try {
        var saved = localStorage.getItem('vatsnap-theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VatSnap" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE).toString()} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE).toString()} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0b1b33" />
    {schemaArray.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="nav" aria-label="Primary">
        <a class="brand" href="/" aria-label="VatSnap home">
          <span class="brand-mark" aria-hidden="true">V</span>
          <span>VatSnap</span>
        </a>
        <div class="nav-links" id="desktop-nav">
          <a href="/">Calculator</a>
          <a href="/vat-rate/">Countries</a>
          <a href="/widget/">Embed</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </div>
        <div class="nav-actions">
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
          </button>
          <button
            class="menu-toggle"
            type="button"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open navigation menu"
          >
            <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
          </button>
        </div>
      </nav>
      <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
        <nav aria-label="Mobile">
          <a href="/">Calculator</a>
          <a href="/vat-rate/">Countries</a>
          <a href="/widget/">Embed</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        <p><strong>VatSnap</strong> — free, unofficial EU VAT rate calculator for small online sellers.</p>
        <p>
          Rates are bundled from the open-source <code>eu-vat-rates-data</code> package
          (source: European Commission TEDB) at build time. Guidance only — confirm with
          your accountant or the official EU source before filing.
        </p>
        <p>
          <a href="/vat-rate/">All country VAT rates</a> · <a href="/widget/">Embed the widget</a> · <a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a>
        </p>
      </div>
    </footer>
  </body>
  <script is:inline>
    try {
      var btn = document.querySelector('[data-theme-toggle]');
      if (btn) {
        btn.addEventListener('click', function () {
          var current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
          var next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('vatsnap-theme', next); } catch (e) {}
        });
      }
      var menuBtn = document.querySelector('[data-menu-toggle]');
      var menu = document.querySelector('[data-mobile-menu]');
      function setMenu(open) {
        if (!menuBtn || !menu) return;
        if (open) {
          menu.removeAttribute('hidden');
          requestAnimationFrame(function () { menu.classList.add('open'); });
          document.querySelector('.site-header').classList.add('menu-open');
        } else {
          menu.classList.remove('open');
          document.querySelector('.site-header').classList.remove('menu-open');
          window.setTimeout(function () { if (!menu.classList.contains('open')) menu.setAttribute('hidden', ''); }, 180);
        }
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        menuBtn.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      }
      function isOpen() { return menuBtn && menuBtn.getAttribute('aria-expanded') === 'true'; }
      if (menuBtn && menu) {
        menuBtn.addEventListener('click', function (e) { e.stopPropagation(); setMenu(!isOpen()); });
        menu.addEventListener('click', function (e) {
          var t = e.target;
          if (t && t.closest && t.closest('a')) setMenu(false);
        });
        document.addEventListener('click', function (e) {
          var t = e.target;
          if (isOpen() && t && !t.closest('.site-header')) setMenu(false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && isOpen()) { setMenu(false); menuBtn.focus(); }
        });
        window.matchMedia('(min-width: 768px)').addEventListener('change', function (mq) {
          if (mq.matches && isOpen()) setMenu(false);
        });
      }
    } catch (e) {}
  </script>
</html>
