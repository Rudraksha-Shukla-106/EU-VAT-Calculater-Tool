---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Something went wrong (500) — VatSnap"
  description="Something went wrong on our side. Try again or head back to the free EU VAT calculator."
  canonicalPath="/500/"
  robots="noindex, follow"
>
  <style>
    .error-wrap { text-align: center; padding: 48px 0 24px; }
    .error-code {
      font-family: var(--font-head);
      font-size: clamp(4rem, 18vw, 8rem);
      font-weight: 600;
      line-height: 1;
      margin: 0;
      color: var(--accent);
    }
    .error-wrap .lede { margin-left: auto; margin-right: auto; }
    .error-actions {
      display: flex; gap: 12px; justify-content: center;
      flex-wrap: wrap; margin: 24px 0;
    }
    .error-actions .btn { min-height: 44px; display: inline-flex; align-items: center; }
    .error-links { margin: 8px 0 0; }
    .error-links a { display: inline-block; padding: 10px 6px; min-height: 44px; }
  </style>
  <div class="error-wrap">
    <p class="error-code" aria-hidden="true">500</p>
    <h1>Something went wrong</h1>
    <p class="lede">That's on us, not you. Your data is safe — calculations run in your browser, so just try again or head back to the calculator.</p>
    <div class="error-actions">
      <button class="btn btn-secondary" type="button" onclick="location.reload()">Try again</button>
      <a class="btn" href="/">Back to calculator</a>
    </div>
    <p class="error-links meta">
      Or try: <a href="/vat-rate/">All country rates</a> · <a href="/about/">About VatSnap</a>
    </p>
  </div>
</BaseLayout>
