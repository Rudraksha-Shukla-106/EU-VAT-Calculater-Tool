---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VatCalculator from '../../components/VatCalculator.astro';
import { COUNTRIES, DATA_VERSION, DATA_SOURCE, formatMoney, formatRate } from '../../lib/vat';
import { DESCRIPTIONS } from '../../lib/descriptions';

/**
 * HOW PROGRAMMATIC COUNTRY PAGES WORK
 * -----------------------------------
 * Astro's dynamic route pattern: this file is `src/pages/vat-rate/[country].astro`.
 * At build time Astro calls `getStaticPaths()` below, which loops over every
 * country in the `eu-vat-rates-data` package (27 EU members + GB) and returns
 * one `{ params: { country: slug }, props: {...} }` entry per country.
 * Astro then renders this template once per entry, emitting pure static HTML
 * files like `/vat-rate/germany/index.html`, `/vat-rate/france/index.html`, …
 * No server, no database — just a build-time loop over offline JSON data.
 */
export async function getStaticPaths() {
  return COUNTRIES.map((c) => ({
    params: { country: c.slug },
    props: { code: c.code },
  }));
}

import { COUNTRY_BY_CODE } from '../../lib/vat';
const { code } = Astro.props as { code: string };
const c = COUNTRY_BY_CODE[code];
if (!c) throw new Error(`Unknown country code: ${code}`);

const paras = DESCRIPTIONS[c.slug] ?? [];
const isGB = c.code === 'GB';
const displayName = isGB ? `${c.name} (non-EU, shown for reference)` : c.name;
const year = (DATA_VERSION || '2026').slice(0, 4);

// SEO title pattern: "VAT Rate in {Country} 2026: {standard}% | VatSnap" (max ~60 chars).
const title = `VAT Rate in ${c.name} ${year}: ${formatRate(c.standard)} | VatSnap`;

// SEO description pattern (max ~155 chars, never truncated mid-word).
function buildDescription(): string {
  const reducedList = c.reduced.length ? c.reduced.map(formatRate).join(', ') : 'none';
  const full = `${c.name} standard VAT is ${formatRate(c.standard)} (reduced: ${reducedList}). Free ${c.name} VAT calculator: add or remove VAT instantly. Rates verified ${DATA_VERSION}.`;
  if (full.length <= 155) return full;
  const short = `${c.name} standard VAT is ${formatRate(c.standard)} (${c.reduced.length} reduced rates). Free ${c.name} VAT calculator: add or remove VAT instantly. Rates verified ${DATA_VERSION}.`;
  if (short.length <= 155) return short;
  // Fallback: drop the "instantly" clause, cut at last space before the limit.
  const fallback = `${c.name} VAT: ${formatRate(c.standard)} standard. Free ${c.name} VAT calculator. Rates verified ${DATA_VERSION}.`;
  if (fallback.length <= 155) return fallback;
  return fallback.slice(0, 152).split(' ').slice(0, -1).join(' ') + '…';
}
const description = buildDescription();

const reducedText = c.reduced.length ? c.reduced.map(formatRate).join(', ') : 'none';
// Neighbouring / nearby countries for the "Related countries" block (3-4 each).
const NEIGHBOURS: Record<string, string[]> = {
  austria: ['germany', 'italy', 'hungary', 'czech-republic'],
  belgium: ['netherlands', 'france', 'germany', 'luxembourg'],
  bulgaria: ['romania', 'greece', 'hungary', 'croatia'],
  cyprus: ['greece', 'malta', 'italy', 'spain'],
  'czech-republic': ['germany', 'austria', 'poland', 'slovakia'],
  germany: ['france', 'netherlands', 'austria', 'poland'],
  denmark: ['germany', 'sweden', 'netherlands', 'finland'],
  estonia: ['latvia', 'lithuania', 'finland', 'sweden'],
  spain: ['france', 'portugal', 'italy', 'germany'],
  finland: ['sweden', 'estonia', 'germany', 'denmark'],
  france: ['germany', 'spain', 'italy', 'belgium'],
  'united-kingdom': ['ireland', 'france', 'netherlands', 'germany'],
  greece: ['bulgaria', 'italy', 'spain', 'croatia'],
  croatia: ['slovenia', 'hungary', 'italy', 'austria'],
  hungary: ['austria', 'romania', 'slovakia', 'croatia'],
  ireland: ['united-kingdom', 'france', 'netherlands', 'germany'],
  italy: ['france', 'germany', 'spain', 'austria'],
  lithuania: ['latvia', 'estonia', 'poland', 'sweden'],
  luxembourg: ['belgium', 'france', 'germany', 'netherlands'],
  latvia: ['lithuania', 'estonia', 'finland', 'sweden'],
  malta: ['italy', 'spain', 'greece', 'cyprus'],
  netherlands: ['belgium', 'germany', 'france', 'luxembourg'],
  poland: ['germany', 'czech-republic', 'slovakia', 'lithuania'],
  portugal: ['spain', 'france', 'italy', 'ireland'],
  romania: ['bulgaria', 'hungary', 'poland', 'croatia'],
  sweden: ['denmark', 'finland', 'germany', 'estonia'],
  slovenia: ['austria', 'italy', 'croatia', 'hungary'],
  slovakia: ['czech-republic', 'austria', 'hungary', 'poland'],
};
const neighbourSlugs = NEIGHBOURS[c.slug] ?? [];
const neighbours = neighbourSlugs
  .map((s) => COUNTRIES.find((o) => o.slug === s))
  .filter((o): o is (typeof COUNTRIES)[number] => Boolean(o));
// EU range comparison sentence (Luxembourg 17% lowest … Hungary 27% highest).
const rangeNote = isGB
  ? `For comparison, EU headline rates run from 17% (Luxembourg) to 27% (Hungary).`
  : c.standard === 17
    ? `At ${formatRate(c.standard)} it shares the lowest headline rate in the EU (EU range: 17%–27%).`
    : c.standard === 27
      ? `At ${formatRate(c.standard)} it is the highest headline rate in the EU (EU range: 17%–27%).`
      : `That sits inside the EU headline range of 17% (Luxembourg) to 27% (Hungary).`;
const faqItems = [
  {
    q: `What is the standard VAT rate in ${c.name}?`,
    a: `The standard VAT rate in ${c.name} (${c.vatName}, ${c.vatAbbr}) is ${formatRate(c.standard)}, according to data tracking the ${DATA_SOURCE} (last verified ${DATA_VERSION}). Most goods sold to ${c.name === 'United Kingdom' ? 'British' : c.name} customers use this rate.`,
  },
  {
    q: c.reduced.length
      ? `Does ${c.name} have reduced VAT rates?`
      : `Does ${c.name} have any reduced VAT rates?`,
    a: c.reduced.length
      ? `Yes — ${c.name} applies reduced rates of ${reducedText}${c.superReduced != null ? `, plus a ${formatRate(c.superReduced)} super-reduced rate` : ''}${c.parking != null ? ` and a ${formatRate(c.parking)} parking rate` : ''}. They cover only the categories defined in national law; everything else uses the ${formatRate(c.standard)} standard rate.`
      : `No — ${c.name} applies a single flat ${formatRate(c.standard)} rate with no reduced bands, so every taxable sale carries the same rate.`,
  },
  {
    q: `What is the VAT rate in ${c.name} for digital products?`,
    a: isGB
      ? `The UK is outside the EU VAT system, so EU One-Stop Shop (OSS) rules do not apply. Digital sales to UK consumers follow separate HMRC rules at the UK rates above — confirm with an accountant before invoicing.`
      : `B2C digital products sold to consumers in ${c.name} are generally taxed at ${c.name}'s applicable VAT rate (${formatRate(c.standard)} standard unless a reduced band explicitly covers the product). Cross-border sellers can usually report this through the EU One-Stop Shop (OSS) instead of registering locally — confirm with an accountant or the official EU TEDB source.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${c.name} VAT Calculator — VatSnap`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: c.currency },
  description,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vatratefinder.com/' },
    { '@type': 'ListItem', position: 2, name: 'EU VAT Rates', item: 'https://vatratefinder.com/vat-rate/' },
    { '@type': 'ListItem', position: 3, name: `${c.name} VAT Rate` },
  ],
};
const exampleNet = 100;
const exampleVat = (exampleNet * c.standard) / 100;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/vat-rate/${c.slug}/`}
  schema={[appSchema, faqSchema, breadcrumbSchema]}
>
  <p><a href="/vat-rate/">← All countries</a> · <a href="/">VAT calculator</a></p>
  <h1>VAT Calculator for {displayName}</h1>
  <p class="lede">
    {c.name}'s standard VAT rate ({c.vatName}, {c.vatAbbr}) is {formatRate(c.standard)}{c.reduced.length ? `, with ${c.reduced.length} reduced rate${c.reduced.length === 1 ? '' : 's'} (${reducedText})` : ' and no reduced rates'}. {rangeNote}
  </p>
  <p class="meta">
    Currency: {c.currency} · Rates last verified: {DATA_VERSION} · Source: {DATA_SOURCE}
  </p>
  <p class="meta">Guidance only — confirm with your accountant or the official EU source before filing or invoicing.</p>

  <div class="card" aria-label="Rate summary">
    <table class="rates">
      <tbody>
        <tr><th scope="row">Standard rate</th><td><strong>{formatRate(c.standard)}</strong></td></tr>
        <tr><th scope="row">Reduced rates</th><td>{reducedText}</td></tr>
        <tr><th scope="row">Super-reduced</th><td>{c.superReduced != null ? formatRate(c.superReduced) : '—'}</td></tr>
        <tr><th scope="row">Parking rate</th><td>{c.parking != null ? formatRate(c.parking) : '—'}</td></tr>
        <tr><th scope="row">Example</th><td>{formatMoney(exampleNet, c.locale, c.currency)} net + {formatMoney(exampleVat, c.locale, c.currency)} VAT = {formatMoney(exampleNet + exampleVat, c.locale, c.currency)} total</td></tr>
      </tbody>
    </table>
  </div>

  {paras.map((p) => <p>{p}</p>)}

  <!-- Calculator is pre-set to THIS country via defaultCode, so visitors
       landing here never have to search for it again. -->
  <VatCalculator defaultCode={c.code} id={`calc-${c.slug}`} />

  <h2>Frequently asked questions</h2>
  <div class="faq">
    {faqItems.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>

  <h2>Related countries</h2>
  <ul class="country-list">
    {neighbours.map((o) => (
      <li>
        <a href={`/vat-rate/${o.slug}/`} style={`--w: ${Math.round((o.standard / 27) * 100)}%; --tint: ${o.standard < 20 ? 'var(--tint-low)' : o.standard > 23 ? 'var(--tint-high)' : 'var(--tint-mid)'};`}>
          <span class="bar" aria-hidden="true"></span>
          <span class="flag" aria-hidden="true">{o.flag}</span>
          <span class="rate-name">{o.name}<small>{o.reduced.length ? `Reduced ${o.reduced.join('%, ')}%` : 'No reduced rates'}</small></span>
          <span class="rate-num">{o.standard}%</span>
        </a>
      </li>
    ))}
  </ul>
  <p><a href="/vat-rate/">See all {COUNTRIES.length} countries →</a></p>

  <h2>VAT guides for sellers</h2>
  <p>
    Selling across borders? Read <a href="/blog/oss-vat-explained/">when the EU One-Stop Shop (OSS) covers your sales</a>
    and <a href="/blog/reverse-vat-calculation/">how to reverse-calculate VAT from a gross price</a> —
    or <a href="/">open the VAT calculator</a> to price your next sale to {c.name}.
  </p>
</BaseLayout>
